# Postgres
POSTGRES_USER=docuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=doc_intel
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=doc-intel

# API
API_PORT=8080

# Connection strings (used by api + worker)
POSTGRES_DSN=postgres://docuser:change-me@postgres_db:5432/doc_intel?sslmode=disable
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_USE_SSL=false

# Gemini API (worker)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
PROMPT_VERSION=v1

# Worker retry policy
MAX_JOB_ATTEMPTS=3
BRPOP_TIMEOUT_SECONDS=5
